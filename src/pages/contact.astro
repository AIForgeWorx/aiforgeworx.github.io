---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---
<Base title="Contact" description="Book a discovery call with AIForgeWorx.">
  <section class="page-head">
    <div class="wrap">
      <h1>Contact us</h1>
      <p>Tell us a little about what you’re working on. We reply within two business days.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <form class="form" action={site.formEndpoint} method="POST">
        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">Work email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="organization">Organization</label>
          <input id="organization" name="organization" type="text" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="topic">What can we help with?</label>
          <select id="topic" name="topic">
            <option>AI Strategy</option>
            <option>AI Privacy &amp; Compliance</option>
            <option>AI Development</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="field">
          <label for="message">Message</label>
          <span class="hint" id="message-hint">Please don’t include personal or confidential information.</span>
          <textarea id="message" name="message" aria-describedby="message-hint" required></textarea>
        </div>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />
        <p class="consent">
          We use what you send only to reply to you. See our <a href="/privacy/">privacy policy</a>.
        </p>
        <div>
          <button class="button button-navy" type="submit">Send message</button>
        </div>
      </form>

      <aside class="aside-panel">
        <h2>Prefer email?</h2>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p>{site.location}</p>
      </aside>
    </div>
  </section>
</Base>
