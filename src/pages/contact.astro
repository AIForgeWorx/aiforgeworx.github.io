---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---
<Base title="Contact" description="Get in touch with AIForgeWorx about AI strategy, privacy and compliance, or development.">
  <section class="page-head">
    <div class="wrap">
      <h1>Contact us</h1>
      <p>Tell us a little about what you’re working on. We reply within two business days.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <div class="prose">
        <h2 style="margin-top: 0">Email us</h2>
        <p>
          The quickest way to reach us is by email. A few lines about your organization and what
          you’d like to achieve with AI is plenty to get started.
        </p>
        <p>
          <a class="button button-navy" href={`mailto:${site.email}?subject=Enquiry%20from%20the%20AIForgeWorx%20website`}>
            Email {site.email}
          </a>
        </p>
        <p class="consent">
          Please don’t include personal or confidential information in your first message. We use
          what you send only to reply to you. See our <a href="/privacy/">privacy policy</a>.
        </p>
      </div>

      <aside class="aside-panel">
        <h2>Where to find us</h2>
        <p><strong>Email</strong><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p><strong>LinkedIn</strong><br /><a href={site.linkedin} rel="noopener">AIForgeWorx on LinkedIn</a></p>
        <p><strong>Based in</strong><br />{site.location}</p>
      </aside>
    </div>
  </section>
</Base>
